# Copy this file to .env and fill it in. Never share .env or paste the token into chat.

# Production (the host): NODE_ENV=production turns on HTTPS-only (redirect + HSTS), Secure cookies,
# the visitor's IP from X-Forwarded-For (rate limits), and forces DEV_PRINT_CODES / DEV_ALLOW_ANY_EMAIL
# off. Leave it unset on your own computer. (TRUST_PROXY=1 does just the IP part.)
NODE_ENV=

# GHL Private Integration token (Settings > Private Integrations). Leave empty for demo data.
# GHL_API_KEY is accepted as the same thing.
GHL_TOKEN=

# Blackmon Tutoring sub-account
GHL_LOCATION_ID=dbijRKgKjGLpLDU9lJxv

# 1 = print sign-in codes in the terminal and send no email (use while testing).
# 0 = email the code to the contact through GHL.
DEV_PRINT_CODES=1

# TESTING ONLY. 1 = any email can sign in: requesting a code creates the GHL contact
# (or sets up an existing one that has no Portal - Role) using the tab picked on the sign-in page:
# Portal - Role, Access Granted = Yes, Location = Little Elm (Parent/Camp Staff),
# Jordan Approved = Yes + Onboarding Status = Training (Camp Staff/Tutor), tag portal-test.
# 0 = only contacts that already have a Portal - Role can sign in.
DEV_ALLOW_ANY_EMAIL=0

# Payment mode for invoices created by "Pay next installment": test or live (default test).
# test = GHL test-mode invoices (no real money; the portal shows a "Test mode" label).
GHL_PAYMENT_MODE=test

# GHL user the invoices are sent from (used by the invoice "send" call).
GHL_USER_ID=Gdffn4IPj4BLO56gXSdb

PORT=3000

# Admin dashboard (/admin). The Owner account is created from these on first start only;
# after that, change the password from the dashboard's Settings page.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-please

# The portal's address, used in every emailed / texted link (invites, sign-in codes, dashboard setup
# links). No trailing slash. In production, requests on any other address are redirected here.
PORTAL_URL=https://portal.blackmontutoring.com

# Where the admin database, ID proofs and profile photos live. On a host, use a persistent disk.
# On the host this is the persistent disk (Render: /var/data). It holds the SQLite database, signed
# waivers, uploads, the editable camp content (content/camp.json) and Ask Blackmon's model.
DATA_DIR=data

# Missing-step reminders and announcements by email / text (admin dashboard).
# test (default) = every email and text goes to ADMIN_ALERT_EMAIL / ADMIN_ALERT_PHONE, labelled with
#                  the parent it was meant for. live = they go to parents. Switch at launch.
PARENT_MESSAGES=test

# Which opportunities count as paid (pipelineId:stageId, comma-separated). Empty = Paid (won) in
# "Winter Camp" (live payments) and "Winter Camp 2026" (test contacts).
PAID_STAGES=
# Optional: only opportunities that reached Paid (won) on/after this date (YYYY-MM-DD) count.
PAID_SINCE=
# Automatic portal invites (on unless 0): every 5 minutes, each contact whose Winter Camp 2026
# opportunity is in Paid (won) gets "Your Blackmon Portal login – Winter Camp 2026" (email + SMS) once,
# at their own email / phone. With PARENT_MESSAGES=test only the SMS goes to ADMIN_ALERT_PHONE.
AUTO_INVITE=1

# Admin alerts (Ask Blackmon "talk to a person"): email + SMS through GHL (Conversations; texts use
# the location's default number). ADMIN_ALERT_CONTACT_ID: send to exactly this GHL contact, which is
# never changed; without it a contact with ADMIN_ALERT_EMAIL is found or created. These are also the
# test contact when PARENT_MESSAGES=test.
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_PHONE=
ADMIN_ALERT_CONTACT_ID=

# Ask Blackmon: chat and Talk answers use Claude when ANTHROPIC_API_KEY is set (otherwise OpenAI).
# Talk's speech to text and spoken voice, and announcement translations, use OPENAI_API_KEY.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: ANTHROPIC_MODEL (default claude-opus-5-5), ANTHROPIC_VOICE_MODEL (Talk answers; default claude-haiku-5-5, the fastest)
